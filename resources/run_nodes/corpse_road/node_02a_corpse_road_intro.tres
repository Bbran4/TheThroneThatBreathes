[resource]
script = ExtResource("4_dtbc0")
node_name = "Corpse Road"
scene_text = "The road narrows between leaning pines.

A corpse-cart lies overturned in the mud. Black birds watch from its broken wheels.
Farther ahead, something drags metal across stone.

What do you do?"
